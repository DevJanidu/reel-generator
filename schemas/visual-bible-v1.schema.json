{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(CHAR|BUILDING|PROP|LOC|STYLE)_[A-Z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "building",
            "prop",
            "location",
            "style"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 40,
          "title": "Description",
          "type": "string"
        },
        "specifications": {
          "items": {
            "$ref": "#/$defs/Property"
          },
          "title": "Specifications",
          "type": "array"
        },
        "provenance": {
          "minLength": 5,
          "title": "Provenance",
          "type": "string"
        },
        "design_status": {
          "enum": [
            "approved",
            "proposed"
          ],
          "title": "Design Status",
          "type": "string"
        },
        "reference_ids": {
          "items": {
            "type": "string"
          },
          "title": "Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "specifications",
        "provenance",
        "design_status",
        "reference_ids"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Property": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Property",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "character",
            "turnaround",
            "building",
            "location",
            "prop",
            "style"
          ],
          "title": "Category",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "essential": {
          "title": "Essential",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "category",
        "path",
        "sha256",
        "approved",
        "essential"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "relation": {
          "enum": [
            "above",
            "below",
            "left_of",
            "right_of",
            "upstream_of",
            "near",
            "taller_than"
          ],
          "title": "Relation",
          "type": "string"
        },
        "object": {
          "title": "Object",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "relation",
        "object",
        "evidence"
      ],
      "title": "Relation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "engine": {
      "const": "ODD_FRAME_VISUAL_CONTINUITY_V1",
      "default": "ODD_FRAME_VISUAL_CONTINUITY_V1",
      "title": "Engine",
      "type": "string"
    },
    "version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    },
    "narration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Narration Sha256",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "maxItems": 1000,
      "title": "Relationships",
      "type": "array"
    },
    "geography": {
      "minLength": 30,
      "title": "Geography",
      "type": "string"
    },
    "palette_lighting": {
      "minLength": 20,
      "title": "Palette Lighting",
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "maxItems": 500,
      "title": "References",
      "type": "array"
    }
  },
  "required": [
    "narration_sha256",
    "assets",
    "relationships",
    "geography",
    "palette_lighting",
    "references"
  ],
  "title": "VisualBible",
  "type": "object"
}
