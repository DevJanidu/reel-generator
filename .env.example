# AI Provider — authenticated Codex CLI preferred
ODD_AI_PROVIDER=codex_cli

# CLI Commands
ODD_CODEX_COMMAND=codex
ODD_CLAUDE_COMMAND=claude

# AI Execution Settings
ODD_AI_TIMEOUT_SECONDS=300
ODD_AI_MAX_CONCURRENT_JOBS=1

# Claude CLI dashboard automation needs one of these (the API key wins if both are set).
# Subscription: run `claude setup-token` and paste the result. Keep it out of chat and git.
CLAUDE_CODE_OAUTH_TOKEN=
# Separately billed Claude Console key:
ANTHROPIC_API_KEY=

# Signature Music
ODD_SIGNATURE_MUSIC=
ODD_SIGNATURE_MUSIC_VERSION=1
ODD_SIGNATURE_MUSIC_RIGHTS=

# OpenAI-compatible provider (unused with Claude CLI)
ODD_AI_BASE_URL=https://api.openai.com/v1
ODD_AI_MODEL=
ODD_AI_API_KEY=

# Context and Output Limits
ODD_AI_CONTEXT_TOKENS=200000
ODD_AI_OUTPUT_TOKENS=12000

# Application Port
ODD_PORT=8123
